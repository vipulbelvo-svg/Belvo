# Vite Frontend & API Environment Configuration

# API URL (Leave blank to use relative proxy in dev or Vercel)
VITE_API_URL=

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_DB=belvo

# Authentication Secrets
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
AUTH_SECRET=your-secure-auth-secret-here-min-32-chars

# Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
INTERN_USERNAME=belvo.internportal
INTERN_PASSWORD=your-secure-intern-password
ALLOWED_INTERN_EMAIL=intern@example.com

# Email Service (Nodemailer)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
HR_EMAIL=hr@example.com

# LLM Fallback Chatbot
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Supabase (if using Supabase storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
