# Server Configuration
PORT=3001

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_DB=belvo

# JWT Authentication Secrets
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
AUTH_SECRET=your-secure-auth-secret-here-min-32-chars

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Intern Portal Configuration
INTERN_USERNAME=belvo.internportal
INTERN_PASSWORD=your-secure-intern-password
ALLOWED_INTERN_EMAIL=intern@example.com

# SMTP Email Configuration (Nodemailer)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
HR_EMAIL=hr@example.com

# AI Chatbot API Keys (Optional for ChatBot)
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Supabase (Optional / Storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
